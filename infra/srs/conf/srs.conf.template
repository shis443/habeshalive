# Birq SRS config — RTMP ingest, HLS output, HTTP callback wiring to
# the API. Adapted from vendor/trunk/conf/hls.conf + http.hooks.callback.conf
# (the real technical docs, read before the vendor .claude/ injection was
# found and removed — see infra/srs/README.md).
#
# __SRS_WEBHOOK_SECRET__ is substituted by docker-entrypoint.sh at container
# start: SRS's config format has no generic ${VAR} interpolation, only
# specific whole-directive env overrides, so templating it ourselves with a
# verified sed placeholder was safer than relying on unconfirmed syntax.

listen              1935;
max_connections     1000;
daemon              off;
srs_log_tank        console;

http_api {
    enabled         on;
    # KNOWN GAP, not yet fixed — see docs/rbac-and-moderation-testing.md's
    # "SRS admin API is IPv4-only" note. SRS only ever binds this to IPv4
    # (confirmed live via /proc/net/tcp[6] on the real machine — only an
    # IPv4 entry ever appears), while Fly's private 6PN network
    # (SRS_ADMIN_API_BASE = http://habeshalive-srs.internal:1985, see
    # apps/api/src/common/env.ts) resolves *.internal hostnames to
    # IPv6-only addresses. Practical effect: every server-to-server call
    # apps/api makes to this admin API over the private network
    # (moderation/actions-service.ts's killActiveRtmpPublishers,
    # streams/whep-routes.ts's WHEP broker) currently gets ECONNREFUSED,
    # silently swallowed by their own fail-open error handling — not a
    # crash, just quietly not working. A dual-stack `listen 1985
    # [::]:1985;` was tried live and did NOT work — SRS's own startup log
    # only ever showed one "HTTP-API listen at tcp://0.0.0.0:1985" line,
    # never attempting the second address, despite parsing the directive
    # without error. Reverted to the simple, known-good single-address
    # form rather than ship an ineffective "fix" with a misleading
    # comment. Needs real investigation (SRS source, or a proxy-based
    # workaround) before attempting again — not a same-day fix.
    listen          1985;
}

http_server {
    enabled         on;
    listen          8080;
    dir             ./objs/nginx/html;
}

# WHIP (WebRTC-HTTP Ingestion Protocol) — lets a browser publish directly
# via getUserMedia + RTCPeerConnection, no OBS/RTMP client needed. Also the
# WebRTC listener WHEP (playback) rides — see the vhost's rtc{} block below
# for where playback is actually enabled.
# __SRS_WEBRTC_CANDIDATE__ is substituted by docker-entrypoint.sh — see its
# own comment for why `*` (auto-detect all interfaces) is wrong on Fly.
rtc_server {
    enabled         on;
    listen          __SRS_WEBRTC_LISTEN__;
    candidate       __SRS_WEBRTC_CANDIDATE__;

    # WebRTC-over-TCP fallback, for viewers/publishers on a network that
    # blocks or mangles UDP (some corporate and mobile-carrier NATs) — SRS
    # has no TURN-server integration of its own (TURN is purely a browser
    # RTCPeerConnection.iceServers concept), this is its native
    # alternative. Reuses the same listen port as the UDP listener above
    # (SRS's own convention — "TCP/8000 corresponding to UDP/8000", see
    # vendor/trunk/conf/full.conf) rather than a second templated port:
    # unlike the UDP listener, this doesn't need the fly-global-services/
    # socat workaround in docker-entrypoint.sh (that's specifically a
    # UDP wildcard-bind-reply-source-IP quirk fly-proxy doesn't handle —
    # TCP is connection-oriented and proxies through Fly normally, same as
    # the RTMP/http_api ports elsewhere in this file). See fly.toml's own
    # TCP [[services]] block for the matching public port mapping.
    tcp {
        enabled     on;
        listen      __SRS_WEBRTC_LISTEN__;
    }

    # SRS's own default is `udp` — enabling rtc_server.tcp above without
    # this would leave it accepting connections but never actually
    # *offered* as a candidate in the SDP answer (per SRS's own config
    # docs: "tcp: Fail if rtc_server.tcp is disabled" implies protocol
    # selection and the tcp{} listener are two independent switches, not
    # one). `all` generates both UDP and TCP candidates so a client whose
    # network blocks UDP actually has a TCP candidate to fall back to.
    protocol        all;
}

# Native Prometheus exporter, shipped in SRS itself since v5.0.67 (verified
# against vendor/trunk/doc/CHANGELOG.md and conf/prometheus.conf) — no
# separate sidecar exporter needed.
exporter {
    enabled         on;
    listen          9972;
}

vhost __defaultVhost__ {
    hls {
        enabled         on;
        hls_path        ./objs/nginx/html;
        # 2s fragments — shortens end-to-end HLS glass-to-glass latency;
        # smaller segments mean more frequent manifest polling and more
        # total HTTP requests per viewer, which is the tradeoff against a
        # wider fragment. See BIRQ guidelines' latency section: this alone
        # won't get under ~5s (inherent to segmented HLS), WHEP/WebRTC
        # playback is the real path there if that's ever needed.
        hls_fragment    2;
        # hls_window is DVR retention depth (how many seconds of past
        # segments stay listed in the live playlist / on disk before
        # SRS prunes them — confirmed against vendor source:
        # srs_app_hls.cpp's segments_->shrink(hls_window_) is what actually
        # deletes old segments), NOT startup latency for a fresh viewer.
        # Those are two independent things: a new viewer's start position
        # is governed by hls_fragment above plus the player's own
        # liveSyncDurationCount (apps/web/components/VideoPlayer.tsx) —
        # both target the newest segments in the playlist regardless of
        # how many older ones are also still listed. Raised from 10 (the
        # bare minimum to avoid the live edge itself rolling off the list)
        # to 120 to back the DVR rewind UI in VideoPlayer.tsx — at 2s
        # fragments that's ~60 segments retained per live stream at once,
        # trivial in disk terms. Not yet re-confirmed live that glass-to-
        # glass latency is actually unaffected by this change, despite the
        # reasoning above — see docs/hls-latency-testing.md before treating
        # that as settled, same as every other latency claim in this repo.
        hls_window      120;
    }

    # Post-stream VOD recording. dvr_path is deliberately OUTSIDE
    # ./objs/nginx/html (http_server's dir above, hls_path above, and the
    # Cloudflare Tunnel in docker-entrypoint.sh all serve/route that exact
    # root publicly) — the same class of bug as the admin-API exposure
    # documented on http_api's listen line above: a recorded stream sitting
    # under the publicly-served root would be downloadable by anyone,
    # unauthenticated, indefinitely, at a guessable-ish
    # {userId}/{timestamp}.mp4 path. Keeping it in a sibling directory
    # means SRS's own http_server (and the Cloudflare Tunnel riding on the
    # same port) simply 404 on it — no path-filtering rule to get right or
    # keep in sync, the file is just not reachable through that route at
    # all. apps/api fetches it instead through the existing internal-only
    # IPv6 bridge (whip-proxy.nginx.conf's `[::]:1985` server, reachable
    # only over Fly's private 6PN — same listener that already serves
    # /api/v1/ and /rtc/v1/whep/), which gained a matching `/dvr/` location
    # in this same change. See streams/routes.ts's /webhooks/vod-ready for
    # the apps/api side that fetches from there.
    dvr {
        enabled     on;
        # session (not segment): one complete file per publish session,
        # reaped at unpublish — matches this app's "one VOD per stream"
        # model. dvr_duration/dvr_wait_keyframe (segment-plan-only per
        # vendor/trunk/conf/full.conf's own comments) don't apply here.
        dvr_plan    session;
        # .mp4, not SRS's .flv default — playable directly by a plain
        # HTML5 <video> element (VodPlayer.tsx), no remux step needed,
        # consistent with vods/service.ts's createVodFromRecording already
        # assuming/producing an .mp4 object key.
        dvr_path    ./objs/dvr/[app]/[stream].[timestamp].mp4;
    }

    # rtc_to_rtmp must be on for a WHIP-published (WebRTC) stream to reach
    # hls{} above at all — HLS muxing hooks off SRS's internal RTMP-style
    # source, not the raw WebRTC ingest, so without this a WHIP publish
    # succeeds (media reaches SRS fine) but produces no .m3u8/.ts output —
    # any viewer just gets a 404 forever. Confirmed live: this was off,
    # browser-published streams connected but were never actually watchable.
    #
    # rtmp_to_rtc on: the WHEP (WebRTC playback) path — bridges the
    # RTMP-style internal source (fed by either an RTMP encoder or a WHIP
    # publish, either way) back out as WebRTC for sub-2s playback. Unlike
    # WHIP publish signaling (public, browser-to-SRS directly), WHEP
    # signaling is brokered server-to-server by apps/api
    # (streams/whep-routes.ts) over Fly's private network — SRS's own
    # /rtc/v1/whep/ endpoint is never exposed to the public internet, see
    # infra/srs/conf/whip-proxy.nginx.conf and fly.toml's comment on the
    # WHIP [[services]] block for why.
    rtc {
        enabled         on;
        rtmp_to_rtc     on;
        rtc_to_rtmp     on;
    }

    # NOTE: SRS's origin_cluster/coworkers feature was tried here and
    # reverted — it relays RTMP/HTTP-FLV *play* requests via redirect
    # (srs_app_coworkers.cpp: SrsCoWorkers::dumps() builds a redirect
    # response for a streaming-protocol play request), it does not affect
    # http_server's static file serving of on-disk HLS segments. Verified
    # live: with the cluster block configured and no parse errors, a node
    # that never ingested a stream still 404s on that stream's .m3u8 over
    # HTTP. The actual fix for cross-node HLS availability is a shared
    # Docker volume for hls_path, mounted into every SRS node — see
    # docker-compose.yml (srs_hls_data) and infra/haproxy/haproxy.cfg.
    http_hooks {
        enabled         on;
        on_publish      __API_WEBHOOK_BASE__/streams/webhooks/live-started?secret=__SRS_WEBHOOK_SECRET__;
        on_unpublish    __API_WEBHOOK_BASE__/streams/webhooks/live-ended?secret=__SRS_WEBHOOK_SECRET__;
        # Fires once dvr{} above finishes writing the session's recording
        # (dvr_plan session — right after on_unpublish, same moment). See
        # streams/routes.ts's /webhooks/vod-ready — this was previously
        # unreachable because this line and the dvr{} block above didn't
        # exist yet; both were added together since one is useless without
        # the other.
        on_dvr          __API_WEBHOOK_BASE__/streams/webhooks/vod-ready?secret=__SRS_WEBHOOK_SECRET__;
    }
}
