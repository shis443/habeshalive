DATABASE_URL=postgres://birq:birq@localhost:5432/birq
REDIS_URL=redis://localhost:6379

JWT_SECRET=dev-only-change-me
VIDEO_WEBHOOK_SECRET=dev-only-change-me
# base64, must decode to exactly 32 bytes — generate with `openssl rand -base64 32`
STREAM_KEY_ENCRYPTION_KEY=dev-only-change-me-32-bytes-b64==
# HMAC secret for remote-control ticket signing — generate with `openssl rand -base64 32`
REMOTE_CONTROL_TICKET_SECRET=dev-only-change-me-32-bytes-min

CENTRIFUGO_URL=http://localhost:8000
CENTRIFUGO_API_KEY=dev-only-change-me
CENTRIFUGO_TOKEN_HMAC_SECRET=dev-only-change-me
# The browser's path to Centrifugo (WebSocket) — different value than
# CENTRIFUGO_URL above in production (that one's this server's internal
# path to Centrifugo's HTTP API), same value in local dev.
NEXT_PUBLIC_CENTRIFUGO_URL=ws://localhost:8000/connection/websocket

# Self-hosted SRS (infra/srs/) — RTMP ingest host and HLS playback host.
# Different in production (real domain/IP) than local dev.
SRS_RTMP_HOST=localhost:1935
SRS_HTTP_HOST=localhost:8080

# Chapa (payments). Both empty in dev on purpose — apps/api/src/wallet/
# chapa-client.ts falls back to a stub checkout, and the webhook route
# refuses (501) rather than accept unsigned wallet credits. Set both to
# real values (CHAPA_SECRET_KEY from the Chapa dashboard's API keys page,
# CHAPA_WEBHOOK_SECRET from its webhook config page) to go live — no code
# changes needed, see docs/architecture.md.
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
SMS_GATEWAY_API_KEY=

# Email (Resend). Empty in dev on purpose — apps/api/src/auth/
# email-gateway.ts falls back to a stub that logs the code to the console
# instead of sending it. Set RESEND_API_KEY (from resend.com/api-keys,
# looks like "re_...") to go live — no code changes needed. RESEND_FROM_EMAIL
# defaults to Resend's own sandbox sender (works with zero domain setup);
# switch it to your own verified domain once you have one.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Birq <onboarding@resend.dev>

# Used to build Chapa's callback_url/return_url and other absolute links —
# must be the real public origin in production, not localhost.
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000

API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Backups (infra/backup) — nightly pg_dump uploaded to an S3-compatible
# bucket. Using Cloudflare R2: dashboard > R2 Object Storage > create a
# bucket, then R2 > Manage API Tokens > create one scoped to that bucket
# (Object Read & Write). BACKUP_S3_ENDPOINT is the account-level R2 endpoint
# Cloudflare shows you (https://<account-id>.r2.cloudflarestorage.com) —
# the bucket name itself is NOT part of the endpoint, it's a separate value.
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_BUCKET=birq-backups
BACKUP_HOUR_UTC=2
BACKUP_RETENTION_DAYS=14
